# Заполните обязательные значения в локальном .env. Реальные ключи сюда не добавляются.
TELEGRAM_BOT_TOKEN=
# Один ключ OpenAI Developer Platform используется для распознавания и пересказа.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Независимые HTTP CONNECT или SOCKS5 прокси; пусто — прямое подключение.
TELEGRAM_PROXY_URL=
OPENAI_PROXY_URL=

STT_MODEL=gpt-transcribe
# Необязательная подсказка языка в ISO 639-1, например ru; пусто — автоопределение.
STT_LANGUAGE=

SUMMARY_MODEL=gpt-6-luna
SUMMARY_LANGUAGE=русский
SUMMARY_MAX_OUTPUT_TOKENS=1200
SUMMARY_MAX_INPUT_CHARS=100000
# Порог саммари для одиночного голосового, в секундах. Пачки получают общее саммари.
SUMMARY_MIN_VOICE_SECONDS=15
# Верхняя граница короткого и обычного исходного текста, в словах.
SUMMARY_SHORT_INPUT_WORDS=80
SUMMARY_LONG_INPUT_WORDS=300
# Порог подробного саммари для пачек из трёх и более записей, в словах.
SUMMARY_BATCH_DETAIL_MIN_WORDS=180
# Целевой объём саммари, в словах; короткий исходник уменьшает ориентир.
# Длина задаётся модели как ориентир, готовый текст не обрезается.
SUMMARY_SHORT_TARGET_WORDS=40
SUMMARY_MEDIUM_TARGET_WORDS=80
SUMMARY_LONG_TARGET_WORDS=140

# Дополнительное ограничение чатов поверх постоянных решений владельца.
# JSON-массив ID: например [-1001234567890,123456789].
ALLOWED_CHAT_IDS=[]
OWNER_ID=
GROUP_STATE_FILE=data/groups.json
# Хеши идентификаторов и ID готовых ответов Telegram, без аудио и текста.
PROCESSED_STATE_FILE=data/processed.jsonl
PROCESSED_MAX_MESSAGES=50000
# Лимит принятых голосовых на пользователя в личке. Новый день начинается в 00:00 UTC.
PRIVATE_DAILY_VOICE_LIMIT=30
PRIVATE_USAGE_FILE=data/private-usage.json
# Серия отдельно для чата, темы и автора; TTL=0 отключает сбор и хранение.
# Фон: пять минут перед каждой репликой; исходники хранятся до TTL + 300 секунд.
CONTEXT_TTL_SECONDS=600
CONTEXT_MAX_CHARS=12000
CONTEXT_MAX_MESSAGES=12
CONTEXT_MAX_SESSIONS=200
CONTEXT_STATE_FILE=data/conversations.json
# Итог на каждое третье голосовое; 0 отключает общие итоги, сохраняя подсказки.
CONTEXT_SUMMARY_EVERY=3
# Серия не длиннее CONTEXT_TTL_SECONDS; эта пауза также начинает новую серию.
CONTEXT_SERIES_GAP_SECONDS=600
# Пересланные подряд голосовые: пауза сбора и максимум записей в одном блоке.
# 0 отключает объединение. Окно одной пачки не превышает 10 секунд.
VOICE_BATCH_PAUSE_SECONDS=3
VOICE_BATCH_MAX_MESSAGES=10
MAX_VOICE_SECONDS=600
MAX_DOWNLOAD_BYTES=19000000
MAX_UPLOAD_BYTES=20000000
MAX_CONCURRENT_JOBS=4
# Постоянная очередь и журнал доставки. Один процесс на файл; права 0600.
QUEUE_STATE_FILE=data/queue.sqlite3
# Один чат не занимает все места. Порядок внутри чата сохраняется.
MAX_PENDING_JOBS=100
MAX_PENDING_JOBS_PER_CHAT=20
# Голосовые одного отправителя в группе: очередь и активная обработка, включая пачки.
MAX_PENDING_VOICES_PER_USER=12
# На каждую активную задачу нужно до MAX_DOWNLOAD_BYTES + MAX_UPLOAD_BYTES памяти /tmp.
TMPFS_SIZE=256m
STOP_GRACE_PERIOD=330s
REQUEST_TIMEOUT_SECONDS=90
JOB_TIMEOUT_SECONDS=300
DOWNLOAD_TIMEOUT_SECONDS=45
CONVERSION_TIMEOUT_SECONDS=45
API_MAX_ATTEMPTS=3
TELEGRAM_MAX_RETRY_AFTER_SECONDS=30
FFMPEG_BINARY=ffmpeg

